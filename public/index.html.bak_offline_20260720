    <div class="container">
        <div class="icon">💳🔊</div>
        <h1>Đăng ký thông tin<br>QR Tài khoản/Loa Thần Tài</h1>
        <p class="subtitle">Nhanh chóng - Tiện lợi - An toàn</p>

        <div id="message" class="message"></div>

        <div class="privacy-notice">
            <span class="lock-icon">🔒</span>
            <span>Thông tin của bạn sẽ được bảo mật và chỉ sử dụng cho mục đích liên hệ, đăng ký và in mẫu biểu khi cần.</span>
        </div>

        <form id="registrationForm">
            <div class="form-group">
                <label for="loai_dang_ky">Loại đăng ký <span class="required">*</span></label>
                <select id="loai_dang_ky" name="loai_dang_ky" required>
                    <option value="">-- Chọn loại đăng ký --</option>
                    <option value="QR Tài khoản">💳 QR Tài khoản</option>
                    <option value="Loa Thần Tài">🔊 Loa Thần Tài</option>
                </select>
            </div>

            <div class="form-group">
                <label for="account_number">Số tài khoản <span class="required">*</span></label>
                <div class="account-input-wrap">
                    <input type="text" id="account_number" name="account_number" placeholder="Nhập số tài khoản hoặc quét QR..." required inputmode="text" autocomplete="off">
                    <button type="button" id="scanAccountQRBtn" class="qr-scan-button" title="Quét mã QR tài khoản" aria-label="Quét mã QR tài khoản">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M3 7V5a2 2 0 0 1 2-2h2"></path><path d="M17 3h2a2 2 0 0 1 2 2v2"></path><path d="M21 17v2a2 2 0 0 1-2 2h-2"></path><path d="M7 21H5a2 2 0 0 1-2-2v-2"></path><path d="M7 7h3v3H7z"></path><path d="M14 7h3v3h-3z"></path><path d="M7 14h3v3H7z"></path><path d="M14 14h1"></path><path d="M17 14h0"></path><path d="M14 17h3"></path>
                        </svg>
                    </button>
                </div>
            </div>

            <div class="form-group">
