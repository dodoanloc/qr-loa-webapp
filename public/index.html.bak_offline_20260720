    <script>
        // Dữ liệu hiện lưu/tra cứu qua PostgreSQL nội bộ: /api/regis-records
        const DATA_API = '/api/regis-records';

        const DOCX_TEMPLATE_URL = 'templates/mau_bieu.docx';
        const PRINT_ENABLED_SERVICE = 'Loa Thần Tài';
        let printMode = false;

        const messageDiv = document.getElementById('message');
        const printFields = document.getElementById('printFields');
        const printSubmitBtn = document.getElementById('printSubmitBtn');
        const submitBtn = document.getElementById('submitBtn');

        function showMessage(type, html) {
            messageDiv.className = `message ${type}`;
            messageDiv.innerHTML = html;
        }

        function clearMessage() {
            messageDiv.className = 'message';
            messageDiv.innerHTML = '';
            messageDiv.style.display = 'none';
        }

        function showFeedbackModal(type, title, html) {
            const modal = document.getElementById('feedbackModal');
            const icon = document.getElementById('feedbackModalIcon');
            document.getElementById('feedbackModalTitle').textContent = title;
            document.getElementById('feedbackModalMessage').innerHTML = html;
            icon.className = `feedback-modal-icon ${type === 'warning' ? 'warning' : ''}`;
            icon.textContent = type === 'warning' ? '⚠️' : '✅';
            modal.classList.add('show');
            modal.setAttribute('aria-hidden', 'false');
        }

        function closeFeedbackModal() {
            const modal = document.getElementById('feedbackModal');
            modal.classList.remove('show');
            modal.setAttribute('aria-hidden', 'true');
        }

        function normalizeSpaces(value) {
            return value.trim().replace(/\s+/g, ' ');
        }

        function digitsOnly(value) {
            return value.replace(/\D/g, '');
        }

        function formatDateForDoc(dateValue) {
            if (!dateValue) return '';
            const [y, m, d] = dateValue.split('-');
            return `${d}/${m}/${y}`;
        }

        function fillerIfBlank(value) {
            const normalized = normalizeSpaces(String(value || ''));
            return normalized || '………..';
        }

        function getNowParts() {
            const now = new Date();
            return {
                ngay_dang_ky: now.toLocaleDateString('vi-VN'),
                gio_dang_ky: now.toLocaleTimeString('vi-VN')
            };
        }

        function isLoaThanTaiSelected() {
            return document.getElementById('loai_dang_ky').value === PRINT_ENABLED_SERVICE;
        }

        function syncPhoneRequirement() {
            const isQrAccount = document.getElementById('loai_dang_ky').value === 'QR Tài khoản';
            const phoneInput = document.getElementById('phone');
            const requiredMark = document.getElementById('phoneRequiredMark');
            phoneInput.required = !isQrAccount;
            requiredMark.style.display = isQrAccount ? 'none' : '';
            phoneInput.placeholder = isQrAccount ? 'Không bắt buộc khi in mã QR tài khoản...' : 'Nhập số điện thoại...';
        }

        function clearPrintFields() {
            ['ten_chu_ho', 'so_cccd', 'ngay_cap', 'noi_cap', 'dia_chi'].forEach(id => {
                document.getElementById(id).value = '';
            });
        }

        function syncPrintButtonState() {
            const enabledByService = isLoaThanTaiSelected();
            printSubmitBtn.disabled = !enabledByService;
            printSubmitBtn.style.opacity = enabledByService ? '1' : '0.55';
            printSubmitBtn.title = enabledByService ? 'Lưu dữ liệu và xuất mẫu biểu DOCX' : 'Chỉ dùng khi chọn loại đăng ký là Loa Thần Tài';
            updatePrintFieldsVisibility(enabledByService, { preserveValues: enabledByService });
            syncPhoneRequirement();
        }

        function updatePrintFieldsVisibility(show, options = {}) {
            const { preserveValues = false } = options;
            printFields.classList.toggle('show', show);

            // Chỉ bắt buộc nhập các trường bổ sung khi người dùng bấm "Đăng ký và In mẫu".
            ['ten_chu_ho', 'so_cccd', 'ngay_cap', 'noi_cap', 'dia_chi'].forEach(id => {
                document.getElementById(id).required = false;
            });

            if (!show && !preserveValues) {
                clearPrintFields();
            }
        }



        // ==================== QR CAMERA SCANNER: điền số tài khoản ====================
        let accountQRStream = null;
        let accountQRScanning = false;
        let accountQRFacingMode = 'environment';

        function setAccountValueFromQR(value) {
            const accountInput = document.getElementById('account_number');
            accountInput.value = value || '';
            accountInput.dispatchEvent(new Event('input', { bubbles: true }));
            accountInput.dispatchEvent(new Event('change', { bubbles: true }));
        }

        function extractAccountNameFromQR(qrData) {
            const namePattern = /59(\d{2})([A-Za-zÀ-ỹ\s]+?)(?=60|63|$)/;
            const nameMatch = qrData.match(namePattern);
            if (nameMatch) {
                const nameLength = parseInt(nameMatch[1], 10);
                const potentialName = nameMatch[2];
                if (!isNaN(nameLength) && potentialName.length >= nameLength) {
                    return potentialName.substring(0, nameLength).trim();
                }
            }
            return null;
        }

        function extractAccountInfoFromVietQR(qrData) {
            if (!qrData) return { accountNumber: null, accountName: null };
            const raw = String(qrData).trim();
            const endMarkerIndex = raw.indexOf('0208QR');
            if (endMarkerIndex > 48) {
                return {
                    accountNumber: raw.substring(48, endMarkerIndex).trim(),
                    accountName: extractAccountNameFromQR(raw)
                };
            }
            const url = raw.match(/(?:accountNo|account|acc|stk|so_tai_khoan)=([^&\s]+)/i);
            if (url) return { accountNumber: decodeURIComponent(url[1]).trim(), accountName: null };
            const labelled = raw.match(/(?:STK|Số tài khoản|So tai khoan|ACCOUNT)\s*[:\-]?\s*([A-Za-z0-9_.\-]+)/i);
            if (labelled) return { accountNumber: labelled[1].trim(), accountName: null };
            const longToken = raw.match(/[A-Za-z0-9_.\-]{6,32}/);
            return { accountNumber: longToken ? longToken[0].trim() : null, accountName: null };
        }

        async function startAccountQRScanner() {
            if (!window.jsQR) {
                showMessage('error', '❌ Chưa tải được thư viện quét QR. Vui lòng tải lại trang rồi thử lại.');
                return;
            }
            if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
                showMessage('error', '❌ Trình duyệt không hỗ trợ camera hoặc trang chưa chạy ở môi trường cho phép camera.');
                return;
            }
            const modal = document.getElementById('accountQRModal');
            const video = document.getElementById('qr-video');
            const status = document.getElementById('cameraStatus');
            try {
                stopAccountQRScanner(false);
                modal.classList.add('show');
                modal.setAttribute('aria-hidden', 'false');
                status.textContent = 'Đang khởi động camera...';
                accountQRStream = await navigator.mediaDevices.getUserMedia({
                    video: {
                        facingMode: accountQRFacingMode,
                        width: { ideal: 1280 },
                        height: { ideal: 720 }
                    },
                    audio: false
                });
                video.srcObject = accountQRStream;
                await video.play();
                status.textContent = `Camera ${accountQRFacingMode === 'environment' ? 'sau' : 'trước'} - Đang quét...`;
                accountQRScanning = true;
                scanAccountQRCodeFrame();
            } catch (err) {
                console.error('Lỗi camera QR:', err);
                showMessage('error', `❌ Không mở được camera: ${err.message}`);
                stopAccountQRScanner();
            }
        }

        function stopAccountQRScanner(hideModal = true) {
            accountQRScanning = false;
            if (accountQRStream) {
                accountQRStream.getTracks().forEach(track => track.stop());
                accountQRStream = null;
            }
            const video = document.getElementById('qr-video');
            if (video && video.srcObject) video.srcObject = null;
            if (hideModal) {
                const modal = document.getElementById('accountQRModal');
                modal.classList.remove('show');
                modal.setAttribute('aria-hidden', 'true');
            }
        }

        function scanAccountQRCodeFrame() {
            const video = document.getElementById('qr-video');
            const canvas = document.createElement('canvas');
            const ctx = canvas.getContext('2d', { willReadFrequently: true });
            const tick = () => {
                if (!accountQRScanning) return;
                if (video.readyState === video.HAVE_ENOUGH_DATA && video.videoWidth > 0) {
                    canvas.width = video.videoWidth;
                    canvas.height = video.videoHeight;
                    try {
                        ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
                        const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
                        const code = jsQR(imageData.data, imageData.width, imageData.height);
                        if (code && code.data) {
                            const info = extractAccountInfoFromVietQR(code.data);
                            if (info.accountNumber) {
                                setAccountValueFromQR(info.accountNumber);
                                stopAccountQRScanner();
                                showMessage('success', `✅ Đã quét và điền số tài khoản: <strong>${info.accountNumber}</strong>`);
                                return;
                            }
                            document.getElementById('cameraStatus').textContent = 'Đã thấy QR nhưng chưa đọc được số tài khoản...';
                        }
                    } catch (err) {
                        console.warn('Lỗi đọc khung hình QR:', err);
                    }
                }
                requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
        }

        function switchAccountQRCamera() {
            accountQRFacingMode = accountQRFacingMode === 'environment' ? 'user' : 'environment';
            stopAccountQRScanner(false);
            setTimeout(startAccountQRScanner, 250);
        }

        document.addEventListener('DOMContentLoaded', function() {
            const savedStaff = localStorage.getItem('can_bo_quan_ly');
            if (savedStaff) {
                const select = document.getElementById('can_bo_quan_ly');
                for (let i = 0; i < select.options.length; i++) {
                    if (select.options[i].value === savedStaff) {
                        select.value = savedStaff;
                        break;
                    }
                }
            }

            syncPrintButtonState();
            document.getElementById('scanAccountQRBtn').addEventListener('click', startAccountQRScanner);
            document.getElementById('closeAccountQRScanner').addEventListener('click', () => stopAccountQRScanner());
            document.getElementById('switchAccountQRCamera').addEventListener('click', switchAccountQRCamera);
            document.getElementById('accountQRModal').addEventListener('click', (e) => { if (e.target.id === 'accountQRModal') stopAccountQRScanner(); });
            document.getElementById('closeFeedbackModal').addEventListener('click', closeFeedbackModal);
            document.getElementById('feedbackModal').addEventListener('click', (e) => { if (e.target.id === 'feedbackModal') closeFeedbackModal(); });
            window.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeFeedbackModal(); });
            window.addEventListener('beforeunload', () => stopAccountQRScanner(false));
            document.getElementById('loai_dang_ky').addEventListener('change', function() {
                syncPrintButtonState();
                if (isLoaThanTaiSelected()) {
                    clearMessage();
                }
            });
        });

        async function exportDocx(data) {
            const response = await fetch(DOCX_TEMPLATE_URL);
            if (!response.ok) {
                throw new Error('Không đọc được template DOCX. Hãy thêm file templates/mau_bieu.docx vào repo.');
            }

            const buffer = await response.arrayBuffer();
            const zip = new PizZip(buffer);
            const doc = new window.docxtemplater(zip, {
                paragraphLoop: true,
                linebreaks: true
            });

            doc.render(data);
            const blob = doc.getZip().generate({
                type: 'blob',
                mimeType: 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
            });

            const fileName = `Mau_bieu_${(data.customer_name || 'khach-hang').replace(/[^\p{L}\p{N}]+/gu, '_')}_${Date.now()}.docx`;
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = fileName;
            document.body.appendChild(link);
            link.click();
            link.remove();
            setTimeout(() => URL.revokeObjectURL(link.href), 1000);
        }

        document.getElementById('registrationForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            clearMessage();
            printMode = e.submitter && e.submitter.id === 'printSubmitBtn';

            // Removed old Airtable config check - now using PostgreSQL

            const formValues = {
                loai_dang_ky: document.getElementById('loai_dang_ky').value,
                account_number: normalizeSpaces(document.getElementById('account_number').value),
                phone: digitsOnly(document.getElementById('phone').value),
                customer_name: normalizeSpaces(document.getElementById('customer_name').value),
                can_bo_quan_ly: document.getElementById('can_bo_quan_ly').value,
                ghi_chu: normalizeSpaces(document.getElementById('ghi_chu').value || ''),
                ten_chu_ho: normalizeSpaces(document.getElementById('ten_chu_ho').value || ''),
                so_cccd: digitsOnly(document.getElementById('so_cccd').value || ''),
                ngay_cap: document.getElementById('ngay_cap').value,
                noi_cap: normalizeSpaces(document.getElementById('noi_cap').value || ''),
                dia_chi: normalizeSpaces(document.getElementById('dia_chi').value || '')
            };

            if (printMode && !isLoaThanTaiSelected()) {
                showMessage('error', '⚠️ Chức năng in mẫu biểu chỉ áp dụng cho đăng ký <strong>Loa Thần Tài</strong>.');
                return;
            }

            submitBtn.disabled = true;
            printSubmitBtn.disabled = true;
            if (printMode) {
                printSubmitBtn.textContent = '💾 Đang lưu & xuất mẫu...';
            } else {
                submitBtn.textContent = '💾 Đang lưu...';
            }

            try {
                if (formValues.loai_dang_ky !== 'QR Tài khoản') {
                    const checkParams = new URLSearchParams({
                        account_number: formValues.account_number,
                        loai_dang_ky: formValues.loai_dang_ky
                    });
                    const checkResponse = await fetch(`${DATA_API}/check?${checkParams.toString()}`);

                    if (!checkResponse.ok) throw new Error('Không thể kiểm tra dữ liệu PostgreSQL');

                    const checkData = await checkResponse.json();
                    if (checkData.records.length > 0) {
                        showFeedbackModal(
                            'warning',
                            'Tài khoản đã đăng ký Loa Thần Tài',
                            `Tài khoản <strong>${formValues.account_number}</strong> đã đăng ký <strong>Loa Thần Tài</strong>.`
                        );
                        return;
                    }
                }

                const payload = {
                    fields: {
                        'Loại đăng ký': formValues.loai_dang_ky,
                        'Số tài khoản': formValues.account_number,
                        'Số điện thoại': formValues.phone,
                        'Tên khách hàng': formValues.customer_name,
                        'Cán bộ quản lý': formValues.can_bo_quan_ly,
                        'Ghi chú': formValues.ghi_chu,
                        'Tên chủ hộ': formValues.ten_chu_ho,
                        'Số CCCD': formValues.so_cccd,
                        'Ngày cấp': formValues.ngay_cap || '',
                        'Nơi cấp': formValues.noi_cap,
                        'Địa chỉ': formValues.dia_chi,
                        'Yêu cầu in mẫu biểu': printMode ? 'Có' : 'Không'
                    }
                };

                const response = await fetch(DATA_API, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                if (!response.ok) {
                    const errorData = await response.json();
                    const errorMessage = errorData?.error?.message || 'Không thể lưu dữ liệu';
                    if (response.status === 409 && formValues.loai_dang_ky === PRINT_ENABLED_SERVICE) {
                        showFeedbackModal(
                            'warning',
                            'Tài khoản đã đăng ký Loa Thần Tài',
                            `Tài khoản <strong>${formValues.account_number}</strong> đã đăng ký <strong>Loa Thần Tài</strong>.`
                        );
                        return;
                    }
                    throw new Error(errorMessage);
                }

                localStorage.setItem('can_bo_quan_ly', formValues.can_bo_quan_ly);

                if (printMode) {
                    const nowParts = getNowParts();
                    await exportDocx({
                        ...formValues,
                        ten_chu_ho: fillerIfBlank(formValues.ten_chu_ho),
                        so_cccd: fillerIfBlank(formValues.so_cccd),
                        ngay_cap: fillerIfBlank(formatDateForDoc(formValues.ngay_cap)),
                        noi_cap: fillerIfBlank(formValues.noi_cap),
                        dia_chi: fillerIfBlank(formValues.dia_chi),
                        ...nowParts
                    });
                }

                showFeedbackModal(
                    'success',
                    'Đăng ký thành công',
                    printMode
                        ? 'Thông tin đã được lưu và hệ thống đã xuất mẫu biểu DOCX.'
                        : 'Thông tin đăng ký đã được lưu thành công.'
                );

                const savedStaff = formValues.can_bo_quan_ly;
                document.getElementById('registrationForm').reset();
                document.getElementById('can_bo_quan_ly').value = savedStaff;
                printMode = false;
                updatePrintFieldsVisibility(false, { preserveValues: false });
                syncPrintButtonState();
                document.querySelector('.button-row').scrollIntoView({ behavior: 'smooth', block: 'center' });
            } catch (error) {
                showMessage('error', `❌ ${error.message}`);
                console.error(error);
            } finally {
                submitBtn.disabled = false;
                printSubmitBtn.disabled = !isLoaThanTaiSelected();
                submitBtn.textContent = '🚀 Đăng ký';
                printSubmitBtn.textContent = '🖨️ Đăng ký và In mẫu';
            }
        });
    </script>
