            <div class="form-group">
                <label for="can_bo_quan_ly">Cán bộ quản lý <span class="required">*</span></label>
                <select id="can_bo_quan_ly" name="can_bo_quan_ly" required>
                    <option value="">-- Chọn cán bộ quản lý --</option>
                    <option value="Đàm Thị Thu Phương">Đàm Thị Thu Phương</option>
